{
  "name": "videojam-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone service that resolves YouTube videos to progressive MP4 or server-packaged SABR/HLS streams for the VideoJam tvOS app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "googlevideo": "^4.1.1",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
