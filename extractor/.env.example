EXTRACTOR_SHARED_SECRET=change-me
# Only needed for docker-compose.synology.yml (Cloudflare Tunnel sidecar).
# Copy this from the Cloudflare Zero Trust dashboard when you create the
# tunnel: https://one.dash.cloudflare.com/ -> Networks -> Tunnels ->
# Create a tunnel -> Cloudflared connector. The token is shown once on the
# install-command step; re-generate from the tunnel's Overview page if lost.
CLOUDFLARE_TUNNEL_TOKEN=change-me
