EXTRACTOR_SHARED_SECRET=change-me
# Only needed for docker-compose.synology.yml (Cloudflare Tunnel sidecar).
# Copy this from the Cloudflare Zero Trust dashboard when you create the
# tunnel: https://one.dash.cloudflare.com/ -> Networks -> Tunnels ->
# Create a tunnel -> Cloudflared connector. The token is shown once on the
# install-command step; re-generate from the tunnel's Overview page if lost.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Only needed for docker-compose.synology.yml. The public hostname you
# routed on the tunnel's Public Hostname tab — used to build the /stream
# proxy URL handed back to the tvOS app.
PUBLIC_BASE_URL=https://videojam-extractor.controlaltdeleted.com

# Optional bounds for SABR -> HLS packaging. Each active/cached session is
# one 720p video; lower the maximum on a space-constrained Docker host.
MAX_HLS_SESSIONS=4
HLS_SESSION_TTL_MS=7200000
HLS_READY_TIMEOUT_MS=45000
